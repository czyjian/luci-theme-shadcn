#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin
case "$1" in
list) echo '{"start":{},"status":{},"qmodem_start":{},"qmodem_status":{}}'; exit 0;;
call) case "$2" in start|status|qmodem_start|qmodem_status) :;; *) exit 1;; esac;;
*) exit 1;;
esac
read -r input
case "$2" in
 qmodem_start|qmodem_status) script=qmodem_update.sh; action=${2#qmodem_};;
 *) script=theme_update.sh; action=$2;;
esac
worker=/usr/share/luci-theme-shadcn-shane/$script
[ -f "$worker" ] || worker=/usr/share/luci-theme-shadcn/$script
exec /bin/sh "$worker" "$action"
